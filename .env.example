PORT_PREFIX=8

POSTGRES_USER=rag_vu_user
POSTGRES_PASSWORD=rag_vu_password
POSTGRES_DB=rag_vu_db
DATABASE_URL=postgresql+asyncpg://rag_vu_user:rag_vu_password@rag_vu-postgres:5432/rag_vu_db
DATABASE_URL_SYNC=postgresql://rag_vu_user:rag_vu_password@rag_vu-postgres:5432/rag_vu_db

# Celery job transport only; events are stored in PostgreSQL.
CELERY_BROKER_URL=redis://redis:6379/0
EVENT_BATCH_SIZE=100
EVENT_POLL_INTERVAL_SECONDS=1
INBOX_LOCK_TIMEOUT_SECONDS=3600
INBOX_REDELIVERY_AFTER_SECONDS=300

OPENROUTER_CHAT_MODEL=
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
EMBEDDING_PROVIDER=ollama
EMBEDDING_BATCH_SIZE=32
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
RERANK_PROVIDER=openrouter
OLLAMA_RERANK_MODEL=gpt-oss:20b
OPENROUTER_API_KEY=yourkey
HF_HUB_OFFLINE=0

# Arize Phoenix tracing (UI: http://localhost:${PORT_PREFIX}006). Docker Compose enables it by
# default; outside Docker it is off unless TRACING_ENABLED=true.
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=rag_vu
# Phoenix UI login (not the API's own auth). Generate with: openssl rand -base64 32
PHOENIX_SECRET=
# First-run admin password for admin@localhost; ignored once that account already exists.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=admin

# Document versioning (all optional; defaults shown). Similarities are on a 0..1 scale.
# VERSIONING_SEM_SIM=0.96
# VERSIONING_DUPLICATE_SEM_SIM=0.995
# VERSIONING_LEX_SIM_MIN=0.5
# VERSIONING_DUPLICATE_LEX_SIM=0.99
# Multi-version retrieval, used for questions about changes between versions.
# MULTI_VERSION_OVERFETCH=4
# K_PER_VERSION=2
# VERSION_RELEVANCE_FLOOR=0.6
# MAX_VERSIONS=4
# MULTI_VERSION_CHUNK_BUDGET=10
